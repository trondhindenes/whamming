{
  "name": "whamming",
  "version": "0.1.0",
  "private": true,
  "description": "A local dashboard that shows what your Claude Code sessions are working on right now.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trondhindenes/whamming.git"
  },
  "homepage": "https://github.com/trondhindenes/whamming",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && electron .",
    "server": "node build.mjs && node dist/server/standalone.js",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "icons": "electron scripts/render-icons.cjs",
    "package": "node build.mjs && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "electron": "^45.3.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
